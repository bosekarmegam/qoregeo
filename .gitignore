# ─── QOREgeo output ──────────────────────────────────────────────────────────
# Maps, images and exports generated by running the library or the CLI.
# Committed assets live in assets/ and are re-included below.
map.html
heatmap.html
choropleth.html
*_map.html
*_heat*.html
output.html
output.geojson
output.csv
reports/
scratch/
tmp/
*.tmp

# Generated map images. Brand assets are kept.
*.png
*.svg
!assets/*.png
!assets/*.svg
!docs/**/*.png
!docs/**/*.svg

# ─── Data ────────────────────────────────────────────────────────────────────
# Sample data belongs in examples/; real datasets do not belong in git.
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
*.gpkg
!tests/**/*.shp
!tests/**/*.dbf
!examples/**

# ─── Docs site build ─────────────────────────────────────────────────────────
docs/_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/Gemfile.lock
.sass-cache/

# ─── Node (only used to vendor Leaflet when testing map output) ──────────────
node_modules/
package-lock.json
package.json

# ─── Editors and operating systems ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ─── Packaging ───────────────────────────────────────────────────────────────
*.whl
*.tar.gz
