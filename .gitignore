*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-wheel-metadata/

# ─── Virtual environments ────────────────────────────────────────────────────
.env
.venv
env/
venv/
ENV/
.python-version

# ─── Test and type-checking artefacts ────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
